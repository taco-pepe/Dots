
# ==========================================
# Taco's Mako Theme
# Catppuccin Mocha | Sharp Edition
# ==========================================

# Typography
font=monospace 10
text-color=#cdd6f4ff
background-color=#1e1e2eff

# Borders: SQUARE GANG
border-size=2
border-color=#cba6f7ff
border-radius=0

# Layout
width=360
height=120
padding=12
margin=8
outer-margin=8
anchor=top-right
layer=overlay

# Icons
icons=1
max-icon-size=40
icon-location=left

# Behavior
default-timeout=5000
ignore-timeout=0
max-visible=5
history=1
sort=-time

# Actions
on-button-left=invoke-default-action
on-button-right=dismiss

# ==========================================
# Urgency overrides
# ==========================================

[urgency=low]
border-color=#a6e3a1ff
default-timeout=3000

[urgency=normal]
border-color=#cba6f7ff
default-timeout=5000

[urgency=critical]
background-color=#313244ff
text-color=#f38ba8ff
border-color=#f38ba8ff
border-size=2
default-timeout=0
ignore-timeout=1
